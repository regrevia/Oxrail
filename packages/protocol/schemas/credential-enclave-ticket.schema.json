{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": { "const": "FIXTURE_ONLY_NON_AUTHORIZING", "type": "string" },
    "consumerId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "consumerRegistryHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "credentialKind": { "const": "API_KEY", "type": "string" },
    "credentialUseId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "grantTtlSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 31536000,
      "type": "integer"
    },
    "handoff": {
      "additionalProperties": false,
      "properties": {
        "acquiredAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "bindingHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
        "documentBinding": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "expiresAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "handoffId": { "maxLength": 4096, "minLength": 1, "type": "string" },
        "leaseEpoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "sessionId": { "maxLength": 4096, "minLength": 1, "type": "string" },
        "tabId": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "taskId": { "maxLength": 4096, "minLength": 1, "type": "string" },
        "topOrigin": { "maxLength": 2048, "type": "string" }
      },
      "required": [
        "handoffId",
        "sessionId",
        "taskId",
        "tabId",
        "topOrigin",
        "documentBinding",
        "leaseEpoch",
        "acquiredAt",
        "expiresAt",
        "bindingHash"
      ],
      "type": "object"
    },
    "issuedAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "provisioningOrigin": { "maxLength": 2048, "type": "string" },
    "purposeId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "registryManifestHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "registryVersion": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": { "const": 1, "type": "number" },
    "serviceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "templateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "templateRegistryHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "ticketId": { "pattern": "^oct1_[a-f0-9]{64}$", "type": "string" }
  },
  "required": [
    "schemaVersion",
    "authority",
    "ticketId",
    "credentialUseId",
    "credentialKind",
    "templateId",
    "serviceId",
    "provisioningOrigin",
    "purposeId",
    "consumerId",
    "grantTtlSeconds",
    "generation",
    "registryVersion",
    "templateRegistryHash",
    "consumerRegistryHash",
    "registryManifestHash",
    "issuedAt",
    "handoff"
  ],
  "type": "object"
}
