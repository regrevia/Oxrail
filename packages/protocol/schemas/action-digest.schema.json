{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionType": { "minLength": 1, "type": "string" },
    "decision": {
      "enum": ["ALLOW", "DENY", "REWRITE", "REQUERY", "HANDOFF"],
      "type": "string"
    },
    "granularity": {
      "enum": ["MICRO_ACTION", "TRANSACTION", "SCRIPT_WRAPPER", "NONE"],
      "type": "string"
    },
    "inputSignature": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "reasonCode": {
      "enum": [
        "OXRAIL_HOST_ROUTE_UNPROVEN",
        "OXRAIL_HOST_PROFILE_STALE",
        "OXRAIL_REDUNDANT_ACTION",
        "OXRAIL_STALE_TARGET",
        "OXRAIL_NO_PROGRESS",
        "OXRAIL_OBSERVATION_BUDGET",
        "OXRAIL_HUMAN_BOUNDARY",
        "OXRAIL_USER_LEASE_ACTIVE",
        "OXRAIL_CREDENTIAL_FENCE_BLOCKED",
        "OXRAIL_UNSAFE_ORIGIN",
        "OXRAIL_VERIFICATION_INCONCLUSIVE",
        "OXRAIL_RECOVERY_EXHAUSTED",
        "OXRAIL_NATIVE_FIDELITY_FAILED",
        "OXRAIL_CONTROL_CRITICAL_UNKNOWN",
        "OXRAIL_NORMAL_ACTION_PASSTHROUGH",
        "OXRAIL_POST_HANDOFF_TARGET_INVALIDATED"
      ],
      "type": "string"
    },
    "route": {
      "enum": [
        "direct-mcp",
        "code-mode-nested-mcp",
        "outer-transaction",
        "script-wrapper",
        "local-function",
        "specialized",
        "opaque"
      ],
      "type": "string"
    },
    "sourceRevision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "targetSignature": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "timestamp": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "toolUseId": { "minLength": 1, "type": "string" }
  },
  "required": [
    "toolUseId",
    "route",
    "granularity",
    "actionType",
    "decision",
    "reasonCode",
    "timestamp"
  ],
  "type": "object"
}
