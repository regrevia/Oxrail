{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "credentialRef": {
          "pattern": "^ocref1_[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "schemaVersion": { "const": 1, "type": "number" },
        "status": { "enum": ["READY", "STORED"], "type": "string" }
      },
      "required": ["schemaVersion", "status", "credentialRef"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1, "type": "number" },
        "status": { "const": "CANCELLED", "type": "string" }
      },
      "required": ["schemaVersion", "status"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "errorCode": {
          "enum": [
            "UNAVAILABLE",
            "NOT_AUTHORIZED",
            "SCOPE_MISMATCH",
            "EXPIRED",
            "REVOKED",
            "INTERNAL_ERROR"
          ],
          "type": "string"
        },
        "schemaVersion": { "const": 1, "type": "number" },
        "status": { "const": "ERROR", "type": "string" }
      },
      "required": ["schemaVersion", "status", "errorCode"],
      "type": "object"
    }
  ]
}
