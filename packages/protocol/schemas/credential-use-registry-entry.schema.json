{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consumerId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "consumerRegistryHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "credentialKind": { "const": "API_KEY", "type": "string" },
    "credentialUseId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "grantTtlSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 31536000,
      "type": "integer"
    },
    "provisioningOrigin": { "maxLength": 2048, "type": "string" },
    "purposeId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "readiness": { "const": "FIXTURE_ONLY", "type": "string" },
    "registryManifestHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "registryVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "schemaVersion": { "const": 1, "type": "number" },
    "serviceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "templateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "templateRegistryHash": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
  },
  "required": [
    "schemaVersion",
    "credentialUseId",
    "credentialKind",
    "templateId",
    "serviceId",
    "provisioningOrigin",
    "purposeId",
    "consumerId",
    "grantTtlSeconds",
    "generation",
    "readiness",
    "registryVersion",
    "templateRegistryHash",
    "consumerRegistryHash",
    "registryManifestHash"
  ],
  "type": "object"
}
