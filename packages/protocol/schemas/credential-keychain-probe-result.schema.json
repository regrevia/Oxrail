{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "probe": { "const": "KEYCHAIN_ROUND_TRIP", "type": "string" },
        "schemaVersion": { "const": 1, "type": "number" },
        "status": { "enum": ["PASSED", "FAILED", "USAGE"], "type": "string" }
      },
      "required": ["schemaVersion", "probe", "status"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "probe": { "const": "KEYCHAIN_ROUND_TRIP", "type": "string" },
        "probeId": { "pattern": "^[a-f0-9]{32}$", "type": "string" },
        "schemaVersion": { "const": 1, "type": "number" },
        "status": { "const": "CLEANUP_FAILED", "type": "string" }
      },
      "required": ["schemaVersion", "probe", "status", "probeId"],
      "type": "object"
    }
  ]
}
