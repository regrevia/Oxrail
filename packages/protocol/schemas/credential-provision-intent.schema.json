{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credentialUseId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "type": "string"
    },
    "schemaVersion": { "const": 1, "type": "number" }
  },
  "required": ["schemaVersion", "credentialUseId"],
  "type": "object"
}
