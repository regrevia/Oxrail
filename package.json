{
  "name": "oxrail",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bootstrap": "node dist/bootstrap.mjs",
    "clean": "node scripts/clean.mjs",
    "doctor": "node dist/doctor.mjs",
    "fixture:serve": "node benchmarks/harness/server.mjs",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.mjs",
    "pilot": "node dist/pilot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:fixture": "playwright test tests/native-fixture.spec.ts",
    "validate:spec": "node scripts/validate-spec.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "verify:evidence": "node dist/verify-evidence.mjs",
    "release:gate": "node dist/release-gate.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate:plugin && pnpm validate:spec && pnpm verify:evidence && pnpm secret:scan"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "zod": "4.1.5"
  }
}
